{
  "name": "organized-ai-agentic-eng",
  "account_id": "691fe25d377abac03627d6a88d3eeac9",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-09-05",
  "workers_dev": true,
  "services": [
    { "binding": "GUIDE_ROUTER", "service": "organizedai-vanity-router" }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "routes": [
    { "pattern": "guide.organizedai.vip/agentic-eng*", "zone_name": "organizedai.vip" }
  ]
}
